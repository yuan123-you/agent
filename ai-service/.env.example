# ===== LLM 供应商（OpenAI 兼容）=====
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_CHAT_MODEL=deepseek-chat
LLM_INTENT_MODEL=deepseek-chat
TEMPERATURE=0.3

# ===== 本地 Embedding（Ollama；官方 4B 标签当前为 Q4_K_M 量化）=====
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_GPU=10
OLLAMA_NUM_CTX=2048
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_DIM=1024
# 切回云端时可改为 openai/maas；fallback 仅用于云端提供商

# ===== 本地 Reranker（社区 Q4_K_M；失败时自动保留 RRF 顺序）=====
RERANKER_ENABLED=true
RERANKER_BASE_URL=http://host.docker.internal:11434
RERANKER_MODEL=dengcao/Qwen3-Reranker-4B:Q4_K_M
RERANKER_CANDIDATES=8
RERANKER_TIMEOUT_S=120

# ===== 联网搜索（可选；配置后优先 Tavily，否则 DuckDuckGo）=====
TAVILY_API_KEY=

# ===== Milvus =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=kb_chunks_qwen3_embedding_4b_q4km_1024
MILVUS_PRODUCT_COLLECTION=product_index_qwen3_embedding_4b_q4km_1024

# ===== 后端回调 =====
BACKEND_BASE_URL=http://localhost:8080
INTERNAL_TOKEN=change-me-internal-token
TOOL_CALLBACK_TIMEOUT_S=3
MAX_TOOL_LOOPS=4

# ===== 可观测性（Langfuse 全链路追踪）=====
# 自托管：docker compose 起的 langfuse 实例；留空即关闭追踪
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_RELEASE=ai-service

# ===== 其他 =====
LINK_GUARD_ENABLED=true
LOG_LEVEL=INFO
