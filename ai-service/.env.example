# ===== LLM 供应商（OpenAI 兼容）=====
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_CHAT_MODEL=deepseek-chat
LLM_INTENT_MODEL=deepseek-chat
TEMPERATURE=0.3

# ===== Embedding（默认使用宿主机 Ollama；本地运行 ai-service 时改为 localhost）=====
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding:4b
EMBEDDING_FALLBACK_MODELS=text-embedding-v1,text-embedding-v3,text-embedding-v2
EMBEDDING_DIM=1024
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_KEEP_ALIVE=2m
OLLAMA_NUM_GPU=10
OLLAMA_NUM_CTX=2048

# ===== 本地 Reranker（社区 Q4_K_M；失败时保留 RRF 顺序）=====
RERANKER_ENABLED=true
RERANKER_BASE_URL=http://host.docker.internal:11434
RERANKER_MODEL=dengcao/Qwen3-Reranker-4B:Q4_K_M
RERANKER_CANDIDATES=8
RERANKER_TIMEOUT_S=120

# ===== T10 RAG 检索与回答置信度 =====
RAG_VECTOR_RECALL_K=20
RAG_BM25_RECALL_K=20
RAG_RRF_K=60
RAG_RRF_TOP_K=10
RAG_FINAL_TOP_K=4
RAG_ANSWER_MIN_SCORE=0.45
RAG_ANSWER_HIGH_CONFIDENCE_SCORE=0.65
RAG_ANSWER_MIN_MARGIN=0.05
RAG_VECTOR_SCORE_CENTER=0.45
RAG_VECTOR_SCORE_SCALE=0.12
RAG_BM25_SCORE_SCALE=8.0

# ===== T10 HTTP Reranker（默认关闭；不影响上方本地 Reranker）=====
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
RAG_RERANKER_BASE_URL=http://host.docker.internal:8001
RAG_RERANKER_ENDPOINT=/v1/rerank
RAG_RERANKER_API_KEY=
RAG_RERANKER_TIMEOUT_S=10
RAG_RERANKER_BATCH_SIZE=10

# ===== 联网搜索（可选；配置后优先 Tavily，否则 DuckDuckGo）=====
TAVILY_API_KEY=

# ===== Milvus =====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=kb_chunks_qwen3_embedding_4b_q4km_1024
# 旧 collection 仅用于查重，避免已生成的 chunk 再次 Embedding
MILVUS_LEGACY_COLLECTIONS=kb_chunks
MILVUS_PRODUCT_COLLECTION=product_index_qwen3_embedding_4b_q4km_1024

# ===== 后端回调 =====
BACKEND_BASE_URL=http://localhost:8080
INTERNAL_TOKEN=dev-internal-token
TOOL_CALLBACK_TIMEOUT_S=3
MAX_TOOL_LOOPS=4

# ===== 可观测性（Langfuse 全链路追踪）=====
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_RELEASE=ai-service

# ===== 其他 =====
LINK_GUARD_ENABLED=true
LOG_LEVEL=INFO
